# Copy this file to .env (git ignores it) and fill it in.
# Real environment variables, if set on a server, win over this file.

# local on your laptop, production on the live site.
#   local:      codes are emailed when RESEND_API_KEY is set, otherwise shown on screen.
#   production: codes are only ever emailed.
APP_ENV=local

# From https://resend.com/api-keys. Leave empty on a laptop to see codes on screen.
RESEND_API_KEY=

# Resend's test sender only delivers to your own Resend account email.
# For production, use an address on a domain you verified in Resend.
MAIL_FROM="Library <onboarding@resend.dev>"
